6\u09b0\u09c7\u09be\u09b9\u09c0\u0995\u09c7 \u09f7 \u09aa\u09b0\u09c7 \u09b8\u09cd\u09a5\u09be\u09a8\u09c0\u09af\u09bc\u09a6\u09c7\u09b0 \u09a4\u09ce\u09aa\u09b0\u09a4\u09be\u09af\u09bc \u09a4\u09be\u0981\u0995\u09c7 \u09a8\u09bf\u09b0\u09be\u09aa\u09a6\u09c7 \u0989\u09a6\u09cd\u09a7\u09be\u09b0 \u0995\u09b0\u09be \u09b9\u09af\u09bc \u09f7\u09aa\u09c1\u09b0\u09c1\u09b2\u09bf\u09af\u09bc\u09be-\u09ac\u09b0\u09be\u0995\u09b0 \u09b8\u09cd\u099f\u09c7\u099f \u09b9\u09be\u0987\u0993\u09af\u09bc\u09c7 \u09a5\u09c7\u0995\u09c7 \u09ac\u09be\u0981\u0995\u09c1\u09a1\u09bc\u09be\u09b0 \u09a6\u09bf\u0995\u09c7 \u09af\u09be\u0993\u09af\u09bc\u09be \u09ae\u09c2\u09b2 \u09b8\u09a1\u09bc\u0995\u09c7\u09b0 \u09ac\u09c7\u09b6 \u0995\u09bf\u099b\u09c1 \u0985\u0982\u09b6 \u099c\u09b2\u09c7\u09b0 \u09a4\u09b2\u09be\u09af\u09bc \u099a\u09b2\u09c7 \u0997\u09bf\u09af\u09bc\u09c7\u099b\u09c7 \u09f7 \u09b0\u09be\u09b8\u09cd\u09a4\u09be\u09b0 \u0989\u09aa\u09b0 \u09a6\u09bf\u09af\u09bc\u09c7 \u09aa\u09cd\u09b0\u09ac\u09b2 \u09ac\u09c7\u0997\u09c7 \u099c\u09b2 \u09ac\u0987\u099b\u09c7 \u09f7 \u09b8\u09c7\u0987 \u09b8\u09ae\u09af\u09bc \u09ac\u09be\u0987\u0995\u09c7 \u0995\u09b0\u09c7 \u09b0\u09be\u09b8\u09cd\u09a4\u09be \u09aa\u09be\u09b0 \u09b9\u0993\u09af\u09bc\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09a4\u09c7\u0987 \u099c\u09b2\u09c7\u09b0 \u09a4\u09c0\u09ac\u09cd\u09b0 \u09b8\u09cd\u09b0\u09c7\u09be\u09a4\u09c7 \u09ac\u09be\u0987\u0995-\u09b8\u09b9 \u09ad\u09c7\u09b8\u09c7 \u09af\u09be\u09a8 \u0993\u0987 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf \u09f7 \u09b8\u09cd\u09a5\u09be\u09a8\u09c0\u09af\u09bc\u09b0\u09be \u09a6\u09cd\u09b0\u09c1\u09a4 \u0998\u099f\u09a8\u09be\u09b8\u09cd\u09a5\u09b2\u09c7 \u09aa\u09c7\u09d7\u0981\u099b\u09c7 \u09a4\u09be\u0981\u0995\u09c7 \u0989\u09a6\u09cd\u09a7\u09be\u09b0 \u0995\u09b0\u09c7\u09a8 \u09f7 \u099f\u09be\u09a8\u09be \u09ac\u09c3\u09b7\u09cd\u099f\u09bf\u09b0 \u099c\u09c7\u09b0\u09c7 \u09b6\u09c1\u09a7\u09c1 \u09b0\u09be\u09b8