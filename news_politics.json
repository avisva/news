ht: 8px solid transparent; transform: translateY(16px);\"> </div> <div style=\"background-color: #f4f4f4; flex-grow: 0; height: 12px; width: 16px; transform: translateY(-4px);\"> </div> <div style=\"width: 0; height: 0; border-top: 8px solid #F4F4F4; border-left: 8px solid transparent; transform: translateY(-4px) translateX(8px);\"> </div> </div> </div> <div style=\"display: flex; flex-direction: column; flex-grow: 1; justify-content: center; margin-bottom: 24px;\"> <div style=\"background-color: #f4f4f4; border-radius: 4px; flex-grow: 0; height: 14px; margin-bottom: 6px; width: 224px;\"> </div> <div style=\"background-color: #f4f4f4; border-radius: 4px; flex-grow: 0; height: 14px; width: 144px;\"> </div> </div> </div> </blockquote> <p style=\"text-align: justify;\"> <script src=\"https://www.instagram.com/embed.js\" async=\"\"></script> </p> <p style=\"text-align: justify;\"><strong>\u0924\u0947\u091c\u0936\u094d\u0930\u0940 \u092a\u094d\u0930\u0927\u093e\u0928\u091a\u0902 \u0917\u0943\u0939\u093f\u0923\u0940\u0902\u0928\u093e \u0916\u093e\u0938 \u0906\u0935\u093e\u0939\u0928 (Tejashri Pradhan On Dialogue Free Episode)</strong></p> <p style=\"text-align: justify;\">'\u0935\u0940\u0923 \u0926\u094b\u0918\u093e\u0902\u0924\u0932\u0940 \u0939\u0940 \u0924\u0941\u091f\u0947\u0928\u093e' \u092e\u093e\u0932\u093f\u0915\u0947\u0924 \u092e\u0941\u0916\u094d\u092f \u092d\u0942\u092e\u093f\u0915\u0947\u0924 \u091d\u0933\u0915\u0923\u093e\u0930\u0940 \u0905\u092d\u093f\u0928\u0947\u0924\u094d\u0930\u0940 \u0924\u0947\u091c\u0936\u094d\u0930\u0940 \u092a\u094d\u0930\u0927\u093e\u0928 \u092e\u094d\u0939\u0923\u093e\u0932\u0940 \u0915\u0940, \"\u0939\u093e \u092e\u093e\u091d\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0928\u0902\u0926\u093e\u091a\u093e \u0926\u093f\u0935\u0938... \u092e\u093e\u0908\u0915 \u0928 \u0932\u093e\u0935\u0924\u093e \u0938\u0947\u091f\u0935\u0930 \u0915\u093e\u092e \u0915\u0930\u093e\u092f\u0932\u093e \u092e\u093f\u0933\u093e\u0932\u0902, \u092f\u093e \u092d\u093e\u0917\u093e\u0924 \u0906\u092e\u094d\u0939\u0940 \u092e\u0942\u0915\u0905\u092d\u093f\u0928\u092f \u0915\u0947\u0932\u093e\u092f. \u0924\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u092a\u094d\u0930\u0947\u0915\u094d\u0937\u0915\u093e\u0902\u0928\u093e \u090f\u0915 \u0906\u0917\u0933\u093e\u0935\u0947\u0917\u0933\u093e \u090f\u092a\u093f\u0938\u094b\u0921 \u092a\u0939\u093e\u092f\u0932\u093e \u092e\u093f\u0933\u0923\u093e\u0930 \u0906\u0939\u0947. \u092b\u0915\u094d\u0924 \u0917\u0943\u0939\u093f\u0923\u0940\u0902\u0928\u093e \u090f\u0915 \u0938\u093e\u0902\u0917\u093e\u092f\u091a\u0902 \u0939\u094b\u0924\u0902 \u0915\u0940, \u0928\u0947\u0939\u092e\u0940 \u0917\u0943\u0939\u093f\u0923\u0940 \u091c\u0947\u0935\u0923 \u092c\u0928\u0935\u0924\u093e\u0928\u093e\u0938\u0941\u0926\u094d\u0927\u093e \u0938\u093f\u0930\u093f\u0905\u0932 \u092a\u093e\u0939\u0924\u093e\u0924. \u0915\u093e\u092e \u0915\u0930\u0924\u093e\u0928\u093e \u0924\u094d\u092f\u093e \u0938\u093f\u0930\u093f\u092f\u0932\u092e\u0927\u0940\u0932 \u092b\u0915\u094d\u0924 \u0921\u093e\u092f\u0932\u0949\u0917 \u0910\u0915\u0924 \u0905\u0938\u0924\u093e\u0924. \u092a\u0923, \u0939\u093e \u092d\u093e\u0917 \u0938\u0902\u0935\u093e\u0926 \u0935\u093f\u0930\u0939\u093f\u0924 \u0905\u0938\u0932\u094d\u092f\u093e\u0928\u0902 \u0917\u0943\u0939\u093f\u0923\u0940\u0902\u0928\u093e \u0915\u093e\u092e\u0902 \u0906\u091f\u092a\u0942\u0928 \u092a\u0939\u093e\u0935\u093e \u0932\u093e\u0917\u0947\u0932... \u0924\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u092e\u0940 \u0938\u0941\u0926\u094d\u0927\u093e \u0939\u0947 \u0938\u0940\u0928 \u092a\u093e\u0939\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0909\u0924\u094d\u0938\u0941\u0915 \u0906\u0939\u0947...\"</p> <p style=\"text-align: justify;\">\u092a\u0941\u0922\u0947 \u092c\u094b\u0932\u0924\u093e\u0928\u093e \u0924\u0947\u091c\u0936\u094d\u0930\u0940 \u092a\u094d\u0930\u0927\u093e\u0928 \u092e\u094d\u0939\u0923\u093e\u0932\u0940 \u0915\u0940, \"\u0906\u092e\u094d\u0939\u093e\u0932\u093e \u0939\u093e \u092d\u093e\u0917 \u0915\u0930\u0924\u093e\u0928\u093e \u092b\u093e\u0930 \u092e\u091c\u094d\u091c\u093e \u0906\u0932\u0940. \u092e\u093e\u0932\u093f\u0915\u0947\u0924\u0940\u0932 \u0938\u0917\u0933\u094d\u092f\u093e\u091a \u0915\u0932\u093e\u0915\u093e\u0930\u093e\u0902\u0928\u0940 \u0905\u0928\u0947\u0915 \u091a\u093e\u0902\u0917\u0932\u0940 \u0915\u093e\u092e\u0902 \u0915\u0947\u0932\u0940\u0924. \u0924\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0939\u093e \u0910\u092a\u093f\u0938\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u094b\u0923\u0932\u093e \u0935\u0947\u0917\u0933\u0940 \u0924\u092f\u093e\u0930\u0940 \u0915\u0930\u093e\u0935\u0940 \u0932\u093e\u0917\u0932\u0940 \u0928\u093e\u0939\u0940. \u092f\u093e\u092e\u0927\u094d\u092f\u0947 \u092b\u0915\u094d\u0924 \u090f\u0915\u092e\u0947\u0915\u093e\u0902\u0915\u0921\u0942\u0928 \u092c\u0918\u0942\u0928 \u0915\u0947\u0932\u0947\u0932\u0947 \u090f\u0915\u094d\u0938\u094d\u092a\u094d\u0930\u0947\u0936\u0928\u094d\u0938 \u0906\u0939\u0947\u0924. \u0906\u092e\u094d\u0939\u093e\u0932\u093e \u0939\u0947 \u0938\u0940\u0928 \u0915\u0930\u0924\u093e\u0928\u093e \u091c\u0936\u0940 \u092e\u091c\u093e \u0906\u0932\u0940, \u0924\u0936\u0940\u091a \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0938\u0941\u0926\u094d\u0927\u093e \u0939\u093e \u092d\u093e\u0917 \u092a\u093e\u0939\u0924\u093e\u0928\u093e \u092f\u0947\u0908\u0932...\"</p> <p style=\"text-align: justify;\"><strong>\u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u094d\u092f\u093e \u0907\u0924\u0930 \u092c\u093e\u0924\u092e\u094d\u092f\u093e :</strong></p> <p class=\"abp-article-title\" style=\"text-align: justify;\"><strong><a href=\"https://marathi.abplive.com/entertainment/kushal-badrike-entry-in-maharashtrachi-hasyajatra-show-after-chala-hawa-yeu-dya-watch-promo-mamachya-gavala-jauya-promotion-1433284\">Kushal Badrike In Maharashtrachi Hasiyajatra Watch Promo: '\u091a\u0932\u093e \u0939\u0935\u093e \u092f\u0947\u090a \u0926\u094d\u092f\u093e' \u0928\u0902\u0924\u0930 \u0915\u0941\u0936\u0932 \u092c\u0926\u094d\u0930\u093f\u0915\u0947 \u0906\u0924\u093e '\u092e\u0939\u093e\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u093e\u091a\u0940 \u0939\u093e\u0938\u094d\u092f\u091c\u0924\u094d\u0930\u093e' \u0917\u093e\u091c\u0935\u0923\u093e\u0930; \u092a\u094d\u0930\u094b\u092e\u094b \u092a\u093e\u0939\u0942\u0928 \u091a\u093e\u0939\u0924\u094d\u092f\u093e\u0902\u091a\u0940 \u0909\u0924\u094d\u0938\u0941\u0915\u0924\u093e \u0936\u093f\u0917\u0947\u0932\u093e</a></strong></p>",
